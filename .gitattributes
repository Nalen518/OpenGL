* text=auto
*.cpp text eol=crlf
*.h text eol=crlf
*.vert text eol=crlf
*.frag text eol=crlf
*.md text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf
*.obj binary
*.dll binary
*.exe binary

# ── GitHub Linguist overrides ──────────────────────────────
# glad.c is a generated OpenGL loader — exclude from language stats
src/glad.c linguist-vendored=true

# Detect GLSL shaders properly
*.vert linguist-language=GLSL
*.frag linguist-language=GLSL
